{
  "manifest_version": 3,
  "name": "SK Inbox Pictures",
  "version": "1.5.0",
  "description": "Copies customer profile pictures and profile links that Business Suite shows into the Sharangakutir CRM inbox. It only reads the inbox and, when asked from the CRM, searches a customer's name. It never opens chats or sends messages.",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.fbcdn.net/*",
    "https://dkwlsfzysjdubcwuemvx.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://business.facebook.com/latest/inbox*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://business.facebook.com/latest/inbox*"
      ],
      "js": [
        "main.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
